#!/bin/bash

###############################################################
# This script sets defaults for BranchSpire to run in the container #
###############################################################

# It assumes that you place this script as branchspire in /usr/local/bin
#
# And place the original in /app/branchspire with working files in $WORK_DIR
BRANCHSPIRE="/app/branchspire/branchspire"
WORK_DIR="/var/lib/branchspire"
APP_INI="/etc/branchspire/app.ini"

APP_INI_SET=""
for i in "$@"; do
	case "$i" in
	"-c")
		APP_INI_SET=1
		;;
	"-c="*)
		APP_INI_SET=1
		;;
	"--config")
		APP_INI_SET=1
		;;
	"--config="*)
		APP_INI_SET=1
		;;
	*)
	;;
	esac
done

if [ -z "$APP_INI_SET" ]; then
	CONF_ARG=("-c" "${GITEA_APP_INI:-$APP_INI}")
fi


# Provide docker defaults
GITEA_WORK_DIR="${GITEA_WORK_DIR:-$WORK_DIR}" exec -a "$0" "$BRANCHSPIRE" "${CONF_ARG[@]}" "$@"
