{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content explore repositories">
	{{template "explore/navbar" .}}
	<div class="ui container">
		<header class="explore-hero">
			<h1 class="explore-hero-title">{{ctx.Locale.Tr "explore.hero_title"}}</h1>
			<p class="explore-hero-lede">{{ctx.Locale.Tr "explore.hero_desc"}}</p>
			<nav class="explore-quick-links" aria-label="{{ctx.Locale.Tr "explore.quick_links"}}">
				<a href="{{AppSubUrl}}/repo/create">{{svg "octicon-plus" 16}}{{ctx.Locale.Tr "explore.new_repo"}}</a>
				<a href="{{AppSubUrl}}/explore/users">{{svg "octicon-person" 16}}{{ctx.Locale.Tr "explore.users_link"}}</a>
				<a href="{{AppSubUrl}}/about">{{svg "octicon-info" 16}}{{ctx.Locale.Tr "explore.about_link"}}</a>
			</nav>
		</header>
		{{template "shared/repo/search" .}}
		{{if .Repos}}
			<div class="explore-results-count">{{ctx.Locale.TrN .Page.Paginator.Total "explore.repos_count_1" "explore.repos_count_n" (CountFmt .Page.Paginator.Total)}}</div>
			<div class="repo-cards">
				{{template "shared/repo/list" .}}
			</div>
		{{else}}
			<div class="explore-empty-list">
				<div class="explore-empty-icon">{{svg "octicon-repo" 40}}</div>
				<h2>{{ctx.Locale.Tr "explore.no_repos_title"}}</h2>
				<p>{{ctx.Locale.Tr "explore.no_repos_desc"}}</p>
			</div>
		{{end}}
		{{template "base/paginate" .}}
	</div>
</div>
{{template "base/footer" .}}
