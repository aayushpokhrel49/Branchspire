{{template "base/head" .}}
<div role="main" class="page-content about-page docs-page">
	<div class="about-container">
		<header class="about-hero">
			<h1 class="about-title">{{ctx.Locale.Tr "docs.title"}}</h1>
			<p class="about-lede">{{ctx.Locale.Tr "docs.intro"}}</p>
		</header>
		<div class="about-sections">
			<section class="about-section">
				<h2 class="about-section-title">{{ctx.Locale.Tr "docs.start.title"}}</h2>
				<p>{{ctx.Locale.Tr "docs.start.desc"}}</p>
				<pre><code>git clone https://your-server/owner/repo.git
cd repo
echo "# My project" &gt; README.md
git add . &amp;&amp; git commit -m "First commit"
git push origin main</code></pre>
			</section>
			<section class="about-section">
				<h2 class="about-section-title">{{ctx.Locale.Tr "docs.branches.title"}}</h2>
				<p>{{ctx.Locale.Tr "docs.branches.desc"}}</p>
			</section>
			<section class="about-section">
				<h2 class="about-section-title">{{ctx.Locale.Tr "docs.ci.title"}}</h2>
				<p>{{ctx.Locale.Tr "docs.ci.desc"}}</p>
				<p>{{ctx.Locale.Tr "docs.steps.title"}}</p>
				<pre><code>name: build
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: make test</code></pre>
			</section>
			<section class="about-section">
				<h2 class="about-section-title">{{ctx.Locale.Tr "docs.security.title"}}</h2>
				<p>{{ctx.Locale.Tr "docs.security.desc"}}</p>
			</section>
			<section class="about-section">
				<h2 class="about-section-title">{{ctx.Locale.Tr "docs.api.title"}}</h2>
				<p>{{ctx.Locale.Tr "docs.api.desc"}}</p>
				<pre><code>{{ctx.Locale.Tr "docs.api.example"}}</code></pre>
				<p><a href="{{AppSubUrl}}/api/swagger">{{ctx.Locale.Tr "docs.api.browse"}}</a></p>
			</section>
		</div>
	</div>
</div>
{{template "base/footer" .}}
