{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user signin{{if .LinkAccountMode}} icon{{else}} auth-page{{end}}">
	<div class="ui middle very relaxed page grid">
		{{/* these styles are quite tricky and should also apply to the signup and link_account pages */}}
		<div class="column tw-flex tw-flex-col tw-gap-5 tw-max-w-lg tw-m-auto">
			{{if not .LinkAccountMode}}
				<a class="auth-brand" href="{{AppSubUrl}}/">
					<img width="48" height="48" src="{{AssetUrlPrefix}}/img/logo.svg" alt="">
					<span class="auth-brand-name">{{AppName}}</span>
				</a>
			{{end}}
			{{template "user/auth/signin_inner" .}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
