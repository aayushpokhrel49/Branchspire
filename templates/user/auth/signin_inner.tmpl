<div class="auth-card">
	{{if .LinkAccountMode}}
		<h2 class="auth-card-title">{{ctx.Locale.Tr "auth.oauth_signin_title"}}</h2>
	{{else}}
		<h1 class="auth-card-title">{{ctx.Locale.Tr "auth.signin_title" AppName}}</h1>
		<p class="auth-card-sub">{{ctx.Locale.Tr "auth.signin_subtitle"}}</p>
	{{end}}

	{{if or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn)}}
		{{template "base/alert" .}}
	{{end}}

	{{if .EnablePasswordSignInForm}}
	<form class="ui form auth-form" action="{{.SignInLink}}" method="post">
		<div class="required field{{if and (.Err_UserName) (or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn))}} error{{end}}">
			<label for="user_name">{{ctx.Locale.Tr "home.uname_holder"}}</label>
			<input id="user_name" type="text" name="user_name" value="{{.user_name}}" autocomplete="username" spellcheck="false" autofocus required tabindex="1">
		</div>
		{{if or (not .DisablePassword) .LinkAccountMode}}
		<div class="required field{{if and (.Err_Password) (or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn))}} error{{end}}">
			<div class="auth-label-row">
				<label for="password">{{ctx.Locale.Tr "password"}}</label>
				<a class="auth-inline-link" href="{{AppSubUrl}}/user/forgot_password" tabindex="5">{{ctx.Locale.Tr "auth.forgot_password"}}</a>
			</div>
			<div class="auth-password-field">
				<input id="password" name="password" type="password" value="{{.password}}" autocomplete="current-password" required tabindex="2">
				<button type="button" class="auth-password-toggle" data-target="password" tabindex="3" data-show-label="{{ctx.Locale.Tr "auth.show_password"}}" data-hide-label="{{ctx.Locale.Tr "auth.hide_password"}}" aria-label="{{ctx.Locale.Tr "auth.show_password"}}">
					<span class="auth-icon-show">{{svg "octicon-eye" 16}}</span>
					<span class="auth-icon-hide">{{svg "octicon-eye-closed" 16}}</span>
				</button>
			</div>
		</div>
		{{end}}
		{{if not .LinkAccountMode}}
		<div class="field auth-remember">
			<div class="ui checkbox">
				<label>{{ctx.Locale.Tr "auth.remember_me"}}</label>
				<input name="remember" type="checkbox" tabindex="6">
			</div>
		</div>
		{{end}}

		{{template "user/auth/captcha" .}}

		<div class="field auth-actions">
			<button type="submit" class="ui primary button auth-submit" tabindex="4">
				{{if .LinkAccountMode}}
					{{ctx.Locale.Tr "auth.oauth_signin_submit"}}
				{{else}}
					{{ctx.Locale.Tr "sign_in"}}
				{{end}}
			</button>
		</div>
	</form>
	{{end}}{{/*end if .EnablePasswordSignInForm*/}}

	{{$showExternalAuthMethods := or .OAuth2Providers .EnableOpenIDSignIn .EnableSSPI}}
	{{if or $showExternalAuthMethods .EnablePasskeyAuth}}
	<div class="auth-alt">
		{{if and $showExternalAuthMethods .EnablePasswordSignInForm}}
			<div class="auth-divider">{{ctx.Locale.Tr "sign_in_or"}}</div>
		{{end}}
		{{if $showExternalAuthMethods}}
			{{template "user/auth/external_auth_methods" .}}
		{{end}}
		{{if .EnablePasskeyAuth}}
			<div class="auth-passkey-row">
				{{template "user/auth/webauthn_error" .}}
				<a class="signin-passkey ui button basic auth-secondary-button">
					{{svg "octicon-key" 16}}
					<span>{{ctx.Locale.Tr "auth.signin_passkey"}}</span>
				</a>
			</div>
		{{end}}
	</div>
	{{end}}

	{{if and (not .LinkAccountMode) .ShowRegistrationButton}}
	<p class="auth-prompt-footer">
		<span>{{ctx.Locale.Tr "auth.need_account"}}</span>
		<a href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "auth.sign_up_now"}}</a>
	</p>
	{{end}}
</div>
