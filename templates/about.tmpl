{{template "base/head" .}}
<div role="main" aria-label="{{ctx.Locale.Tr "about"}}" class="page-content about-page about-home about-story-page">
	<section class="about-hero" aria-labelledby="about-page-title">
		<div class="about-wrap about-hero-grid">
			<div class="about-hero-copy">
				<h1 id="about-page-title" class="about-hero-title">{{ctx.Locale.Tr "about.page_title"}}</h1>
				<p class="about-hero-lede">{{ctx.Locale.Tr "about.lede"}}</p>
				<div class="about-hero-actions">
					<a class="about-button" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "about.cta_explore"}}</a>
					<a class="about-link" href="{{AppSubUrl}}/why">{{ctx.Locale.Tr "about.why_link"}}</a>
				</div>
			</div>

			<div class="about-hero-ui" aria-hidden="true">
				<div class="about-ui about-ui-teams" data-ui>
					<div class="about-ui-toolbar">
						<span>{{svg "octicon-people" 14}} People</span>
						<span class="about-ui-muted">3 members</span>
					</div>
					<div class="about-ui-member">
						<span class="about-ui-avatar">AP</span>
						<div><strong>Aayush Pokhrel</strong><span>@aayush</span></div>
						<span class="about-ui-role">Owner</span>
					</div>
					<div class="about-ui-member">
						<span class="about-ui-avatar">BS</span>
						<div><strong>BranchSpire Bot</strong><span>@branchspire</span></div>
						<span class="about-ui-role">Maintainer</span>
					</div>
					<div class="about-ui-member">
						<span class="about-ui-avatar">+</span>
						<div><strong>3 collaborators</strong><span>Read access</span></div>
						<span class="about-ui-role">Team</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	{{if and .NumUsers .NumRepos}}
	<section class="about-numbers" aria-labelledby="about-numbers-heading">
		<div class="about-wrap">
			<div class="about-section-head">
				<h2 id="about-numbers-heading">{{ctx.Locale.Tr "about.stats_heading"}}</h2>
			</div>
			<dl class="about-numbers-grid">
				<div class="about-number">
					<dt>{{ctx.Locale.Tr "startpage.stats_users"}}</dt>
					<dd>{{.NumUsers}}</dd>
				</div>
				<div class="about-number">
					<dt>{{ctx.Locale.Tr "startpage.stats_repos"}}</dt>
					<dd>{{.NumRepos}}</dd>
				</div>
				<div class="about-number">
					<dt>{{ctx.Locale.Tr "startpage.stats_orgs"}}</dt>
					<dd>{{.NumOrgs}}</dd>
				</div>
			</dl>
		</div>
	</section>
	{{end}}

	<section class="about-principles" aria-labelledby="about-principles-heading">
		<div class="about-wrap">
			<div class="about-section-head">
				<h2 id="about-principles-heading">{{ctx.Locale.Tr "about.principles_heading"}}</h2>
			</div>
			<div class="about-principles-grid">
				<article class="about-principle">
					<h3>{{ctx.Locale.Tr "about.principle_own_title"}}</h3>
					<p>{{ctx.Locale.Tr "about.principle_own_desc"}}</p>
				</article>
				<article class="about-principle">
					<h3>{{ctx.Locale.Tr "about.principle_light_title"}}</h3>
					<p>{{ctx.Locale.Tr "about.principle_light_desc"}}</p>
				</article>
				<article class="about-principle">
					<h3>{{ctx.Locale.Tr "about.principle_clear_title"}}</h3>
					<p>{{ctx.Locale.Tr "about.principle_clear_desc"}}</p>
				</article>
			</div>
		</div>
	</section>

	<section class="about-capabilities" aria-labelledby="about-timeline-heading">
		<div class="about-wrap">
			<div class="about-section-head">
				<h2 id="about-timeline-heading">{{ctx.Locale.Tr "about.timeline_heading"}}</h2>
			</div>
			<div class="about-timeline">
				<article class="about-timeline-item">
					<span class="about-timeline-step">{{ctx.Locale.Tr "about.timeline_1_step"}}</span>
					<h3>{{ctx.Locale.Tr "about.timeline_1_title"}}</h3>
					<p>{{ctx.Locale.Tr "about.timeline_1_desc"}}</p>
				</article>
				<article class="about-timeline-item">
					<span class="about-timeline-step">{{ctx.Locale.Tr "about.timeline_2_step"}}</span>
					<h3>{{ctx.Locale.Tr "about.timeline_2_title"}}</h3>
					<p>{{ctx.Locale.Tr "about.timeline_2_desc"}}</p>
				</article>
				<article class="about-timeline-item">
					<span class="about-timeline-step">{{ctx.Locale.Tr "about.timeline_3_step"}}</span>
					<h3>{{ctx.Locale.Tr "about.timeline_3_title"}}</h3>
					<p>{{ctx.Locale.Tr "about.timeline_3_desc"}}</p>
				</article>
			</div>
		</div>
	</section>

	<section class="about-anywhere" aria-labelledby="about-stack-heading">
		<div class="about-wrap about-anywhere-grid">
			<div class="about-anywhere-copy">
				<h2 id="about-stack-heading">{{ctx.Locale.Tr "about.stack_heading"}}</h2>
				<p class="help">{{ctx.Locale.Tr "about.stack_ci_note"}}</p>
			</div>
			<dl class="about-anywhere-list is-2x2">
				<div>
					<dt>{{ctx.Locale.Tr "about.stack_binary_label"}}</dt>
					<dd>{{ctx.Locale.Tr "about.stack_binary"}}</dd>
				</div>
				<div>
					<dt>{{ctx.Locale.Tr "about.stack_db_label"}}</dt>
					<dd>{{ctx.Locale.Tr "about.stack_db"}}</dd>
				</div>
				<div>
					<dt>{{ctx.Locale.Tr "about.stack_core_label"}}</dt>
					<dd>{{ctx.Locale.Tr "about.stack_core"}}</dd>
				</div>
				<div>
					<dt>{{ctx.Locale.Tr "about.stack_ci_label"}}</dt>
					<dd>{{ctx.Locale.Tr "about.stack_ci"}}
						<span class="about-ui-pill is-ok" style="margin-left: 0.5rem; font-size: 0.75rem;">{{ctx.Locale.Tr "about.stack_ci_badge"}}</span>
					</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="about-colophon" aria-labelledby="about-developer-heading">
		<div class="about-wrap about-colophon-grid">
			<div class="about-colophon-note">
				<h2 id="about-developer-heading">{{ctx.Locale.Tr "about.developer_heading"}}</h2>
				<p>{{ctx.Locale.Tr "about.developer_text"}}</p>
				<p class="about-colophon-fork">{{ctx.Locale.Tr "about.built_on"}}</p>
			</div>
			<div class="about-colophon-meta">
				<nav class="about-colophon-links" aria-label="{{ctx.Locale.Tr "about.developer_heading"}}">
					<a href="https://github.com/aayushpokhrel49/Branchspire" target="_blank" rel="noopener noreferrer">{{svg "octicon-code" 16}} {{ctx.Locale.Tr "about.developer_source"}}</a>
					<a href="https://aayushhpokhrel.com.np" target="_blank" rel="noopener noreferrer">{{svg "octicon-globe" 16}} aayushhpokhrel.com.np</a>
					<a href="https://x.com/aayushpokhrel49" target="_blank" rel="noopener noreferrer">{{svg "octicon-link-external" 16}} @aayushpokhrel49</a>
				</nav>
				{{if and .AppVer (ne .AppVer "development")}}
					<p class="about-colophon-version">{{ctx.Locale.Tr "about.version_label"}} <span>v{{.AppVer}}</span></p>
				{{end}}
			</div>
		</div>
	</section>

	<section class="about-cta" aria-labelledby="about-cta-heading">
		<div class="about-wrap about-cta-inner">
			<h2 id="about-cta-heading">{{ctx.Locale.Tr "about.cta_heading"}}</h2>
			<p>{{ctx.Locale.Tr "about.cta_desc"}}</p>
			<div class="about-cta-actions">
				<a class="about-button" href="{{AppSubUrl}}/explore/repos">{{ctx.Locale.Tr "about.cta_explore"}}</a>
				{{if .ShowRegistrationButton}}
					<a class="about-link" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "sign_up"}}</a>
				{{else}}
					<a class="about-link" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
				{{end}}
			</div>
		</div>
	</section>
</div>
{{template "base/footer" .}}
